# Copy to backend/.env and fill in.

DATABASE_URL=postgresql+psycopg2://gridpulse:gridpulse@localhost:5432/gridpulse

# Free key: https://www.eia.gov/opendata/register.php
# Only needed for real ingestion; `python -m gridpulse.seed` works without it.
EIA_API_KEY=

# JSON list of origins allowed to call the API.
CORS_ORIGINS=["http://localhost:3000"]
